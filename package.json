{
  "name": "endora-album",
  "productName": "Endora Album",
  "version": "1.0.4",
  "description": "Professional wedding album design software for Sri Lankan photographers",
  "main": "main/main.js",
  "author": "Endora",
  "license": "UNLICENSED",
  "private": true,
  "endora": {
    "macSigned": false
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "release:mac": "electron-builder --mac --x64 --arm64 --publish always",
    "release:win": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "lk.endora.album",
    "productName": "Endora Album",
    "files": [
      "main/**",
      "renderer/**",
      "cloudflare/src/**",
      "cloudflare/schema.sql",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "eapasindu-sudo",
        "repo": "endora-album-releases",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Endora-Album-${version}-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Endora-Album-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "dmg": {
      "title": "Endora Album ${version}",
      "background": "build/background.png",
      "iconSize": 96,
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        {
          "x": 165,
          "y": 180
        },
        {
          "x": 495,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "releaseInfo": {
      "releaseNotes": "### Download\n- **Windows:** `Endora-Album-Setup-x.x.x.exe`\n- **Mac M1 / M2 / M3 / M4:** `Endora-Album-x.x.x-arm64.dmg`\n- **Intel Mac:** `Endora-Album-x.x.x-x64.dmg`\n\n### Mac: first time opening (no Terminal needed)\n1. Open the `.dmg` and drag **Endora Album** into **Applications**.\n2. Open the app. If it says *\"Apple could not verify…\"*, press **Done**.\n3. Open **System Settings → Privacy & Security**, scroll down and press **Open Anyway**, then enter your Mac password.\n\nපළමු වතාවට: **System Settings → Privacy & Security** එකේ **Open Anyway** ඔබන්න. ඊට පස්සේ app එක සාමාන්‍ය විදිහට open වෙනවා.\n\nDownload the `.dmg` with Safari or Chrome. A file sent through WhatsApp or Telegram can show \"damaged\".\n\n### Windows: first time\nIf Windows shows *\"Windows protected your PC\"*, press **More info → Run anyway**."
    }
  }
}
